# KensaraAI — environment variables
# Generated by scripts/make_env_template.py. Import into Vercel via
# Settings -> Environment Variables -> Import .env, then REDEPLOY:
# variables only reach deployments created after they were saved.
#
# Blank means unset. Do not write replace_me — the app reads placeholder
# values as unset, which looks identical to a missing key.

# ── LLM providers ───────────────────────────────────────────────
ALLTOKEN_API_KEY=
ALLTOKEN_BASE_URL=https://api.openai.com/v1
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
NVIDIA_API_KEY=
NVIDIA_MODEL_ANALYTICAL=qwen/qwen3-5-122b-a10b
NVIDIA_MODEL_BLOG=mistralai/mistral-medium-3.5-128b
NVIDIA_MODEL_FAST=deepseek-ai/deepseek-v4-flash

# ── Research and search ─────────────────────────────────────────
GEMINI_API_KEY=
PERPLEXITY_API_KEY=
SERPER_API_KEY=
TAVILY_API_KEY=

# ── Database ────────────────────────────────────────────────────
SUPABASE_SERVICE_KEY=
SUPABASE_URL=

# ── Publishing ──────────────────────────────────────────────────
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORGANIZATION_ID=
MAILCHIMP_API_KEY=
MAILCHIMP_LIST_ID=
WORDPRESS_APP_PASSWORD=
WORDPRESS_ENFORCEMENT_TRACKER_SLUG=enforcement-tracker
WORDPRESS_URL=https://kensara.in
WORDPRESS_USER=

# ── Search Console ──────────────────────────────────────────────
# Search Console property, e.g. sc-domain:kensara.in
GSC_SITE_URL=

# ── Platform ────────────────────────────────────────────────────
BLOG_CADENCE=daily
# Guards /api/cron/*. Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
CRON_SECRET=
INTEGRATION_TEST=false
NEWS_MAX_AGE_DAYS=90

# Not set here on purpose:
#   CONTENT_OUTPUT_DIR — computed at runtime from DATA_DIR
#   DATA_DIR — resolves to /tmp on serverless automatically; setting it wrong breaks writes
#   DEBUG_STARTUP — set it temporarily, by hand, only while diagnosing a failed start
#   GSC_SERVICE_ACCOUNT_FILE — expects a file on disk; the serverless bundle is read-only
